#!/bin/sh
# Block pushing scripts/ from main (scripts live on the scripts branch).

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
[ "$branch" = "main" ] || exit 0

while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    if git diff --name-only "$range" 2>/dev/null | grep -q '^scripts/'; then
        echo "error: refusing to push scripts/ from main."
        echo "       Commit script changes on the scripts branch instead."
        exit 1
    fi
done

exit 0
